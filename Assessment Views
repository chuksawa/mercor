<h2> Assessment Tracking Dashboard</h2>

<!-------Submission Form----------->
<form asp-action="Submit" method="post" style="margin-bottome:20px;">
  <h3> Submit New Items </h3>
  <input type="text" name="title" placeholder="Item Title" required />
  <input type="text" name="submitter" placeholder="Your Name" required />
  <button type="submit"> Submit </button>
</form>

<!-------Tracking Table----------->
<table border="1" cellpadding="10">
  <thead>
    <tr>
      <th> ID </th>
      <th> Title </th>
      <th> Submitter </th>
      <th> Status </th>
      <th> Reviewer </th>
      <th> Actions </th>
    <tr>
  </thead>
  <tbody>
    @foreach (vasr item in Model)
    {
    <tr>
      <td>@item.Id </td>
      <td>@item.Title </td>
      <td>@item.Submitter </td>
      <td>@item.Status </td>
      <td>@item.Reviewer </td>
      <td>
          @if(item.Status == "Submitted") 
          {
            <form asp-action="Assign" asp-rout=id="@item.Id" method="post" style="display:inline;">
            <input type="text" name="reviewer" placeholder="Reviewer Name" required/>
            <button type="submit"> Assign </button>
            </form>
          }
          @if (item.Status == "Assigned")
          {
            <form asp-action="Review" asp-rout=id="@item.Id" method="post" style="display:inline;">
            <button type="submit"> Mark Reviewed </button>
            </form>
          }
      </td>
    <tr>
    }
  </tbody>
</form>









